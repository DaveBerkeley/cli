
gtest_dir = '/usr/src/gtest/lib/'

test_files = [
    'gtest.cpp',
    'test_io.cpp',
    'list_test.cpp',
    'cli_test.cpp',
    'linux/mutex.cpp',
    'linux/io.cpp',
]

files = [
    '../src/cli.cpp',
    '../src/debug.c',
    '../src/list.cpp',
] + test_files

libs = [
    'pthread',
    'gtest',
]

cflags = [
    '-Wall',
    '-Wextra',
    '-Werror',
    '-Wswitch-default',
    '-Wswitch-enum',
    '-Wconversion',
    '-Wunused-parameter',

    '-Wno-missing-field-initializers',

    '-g',
    '-DGOOGLETEST',
    '-DCLI_NS=cls_ns',
    '-Isrc',
]

cxxflags = [
    '-std=c++14',
]

lflags = [
    #'-lgtest_main',
    '-lgtest',
    '-lpthread',
]

import os
environ = os.environ
cc = environ.get('CC', 'gcc')
cxx = environ.get('CXX', 'g++')

if cc == 'clang':
    sane = [
        '-fsanitize=thread',
        '-fsanitize=alignment',
        '-fno-sanitize-recover=all',
    ]
    for x in sane:
        cflags  += [ x ]
        cxxflags += [ x ]
        lflags  += [ x ]

env = Environment(CCFLAGS=cflags, CXXFLAGS=cxxflags, LINKFLAGS=lflags, CC=cc, CXX=cxx)
tdd = env.Program(target='tdd', source=files, LIBS=libs)

env.Alias('tdd', tdd)

